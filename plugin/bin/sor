#!/bin/sh
# Run the sor binary: the one on PATH if any, else a cached copy of the
# latest release, downloaded on first use. Users never build anything.
set -eu

self="$(cd "$(dirname "$0")" && pwd)/sor"
IFS=:
for dir in $PATH; do
  if [ -x "$dir/sor" ] && [ "$dir/sor" != "$self" ]; then
    exec "$dir/sor" "$@"
  fi
done
unset IFS

cache="${CLAUDE_PLUGIN_DATA:-${XDG_DATA_HOME:-$HOME/.local/share}/sync-optimized-rules}/bin"
if [ ! -x "$cache/sor" ]; then
  # The plugin's hooks run in every session: they never download anything.
  if [ -n "${SOR_NO_DOWNLOAD:-}" ]; then
    exit 0
  fi
  echo "sor: downloading the latest release..." >&2
  url="https://github.com/Khara-AI/sync-optimized-rules/releases/latest/download/install.sh"
  # Fetched first: piped straight into sh, a failed download would pass for success.
  if ! script="$(curl -fsSL "$url")" \
    || ! printf '%s\n' "$script" | SOR_INSTALL_DIR="$cache" sh >/dev/null; then
    echo "sor: the download failed. Install sor by hand: https://github.com/Khara-AI/sync-optimized-rules#install" >&2
    exit 1
  fi
  echo "sor: this copy is Claude's. For the keyboard menus in your own terminal, run /sor:cli" >&2
fi
export SOR_PLUGIN_COPY=1
exec "$cache/sor" "$@"
